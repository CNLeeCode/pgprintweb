# 环境配置模板
# 使用方法：复制本文件为 .env（开发）或 .env.production（生产），填入真实值
# ⚠️ .env / .env.production 含敏感配置，已加入 .gitignore，禁止提交 git

# 后端接口域名
VITE_DOMAIN_URL=

# 接口前缀
VITE_API_PREFIX=

# 接口鉴权密钥
VITE_API_SECRET=

# 应用版本号
VITE_APP_VERSION=

# 自动更新检查接口地址（留空则用 DOMAIN_URL + API_PREFIX 拼接默认接口）
VITE_UPDATE_SERVER_URL=

# 版本号检查开关（false 时跳过更新检查，直接进入应用）
VITE_VERSION_CHECK_ENABLED=true
