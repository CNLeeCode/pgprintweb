# 开发环境配置
# 后端接口域名（KMP 原版域名，沿用）
VITE_DOMAIN_URL=http://<生产域名>
# 应用版本号（Electron 版从 1.0.0 起，独立于 KMP 版本）
VITE_APP_VERSION=1.0.1
# 自动更新下载地址（electron-updater feed URL，指向存放 latest.yml + nsis 包的目录）
# ⚠️ 待提供：此地址后续单独提供，当前留空表示下载功能不可用（版本号检查仍可用）
# 配置示例：VITE_UPDATE_SERVER_URL=http://your-update-server.com/pgprint-update/
VITE_UPDATE_SERVER_URL=http://<更新服务IP>/index.php/Home/<接口前缀名>/getWebPgPrintUpdateInfo
# 版本号检查开关（false 时跳过 getLastAppVersionData 检查，直接进入应用）
VITE_VERSION_CHECK_ENABLED=true
