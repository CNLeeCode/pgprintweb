node_modules/
out/
dist/
# 注意：不忽略 build/ —— 它是 electron-builder 的 buildResources 目录
# (installer.nsh / icon / license 等资源文件必须随 git 提交，CI 打包才生效)
# 实际打包产物输出目录是 release/（见下方），已与 build/ 区分
*.log
.DS_Store
# .env / .env.production 本项目已转私有仓库，直接提交 git
# （CI 通过 loadEnv 读取，换机器 clone 即可运行，无需额外配置 Secrets）
.env.local
release/
.vscode/
.idea/